{
  "about": "A/B benchmark (Definition of Done). A = Claude Code alone with the raw request. B = Baguette (grill answered with the recommended options, brief, routing, verification, one automatic fix). Hidden checks are never shown to A or B.",
  "tasks": [
    {
      "id": "t1-bakery-site",
      "persona": "beginner",
      "fixture": null,
      "request": "Create a showcase website for my bakery \"Au Bon Pain\" in Lyon: an introduction, the opening hours (Tuesday to Sunday, 7am to 7pm), three signature products and a contact form. The site must be in English and display well on phones.",
      "checks": [
        { "id": "home", "kind": "html_exists" },
        { "id": "name", "kind": "html_contains", "pattern": "Au Bon Pain" },
        { "id": "opens", "kind": "html_contains", "pattern": "(?i)7\\s*(am|a\\.m\\.)|07[:h]00" },
        { "id": "closes", "kind": "html_contains", "pattern": "(?i)7\\s*(pm|p\\.m\\.)|19[:h]00" },
        { "id": "days", "kind": "html_contains", "pattern": "(?i)tuesday" },
        { "id": "form", "kind": "html_contains", "pattern": "(?i)<form" },
        { "id": "mobile", "kind": "html_contains", "pattern": "(?i)name=[\"']viewport[\"']" },
        { "id": "english", "kind": "html_contains", "pattern": "(?i)<html[^>]*lang=[\"']en" },
        { "id": "links", "kind": "local_links_ok" }
      ]
    },
    {
      "id": "t2-todo-feature",
      "persona": "developer",
      "fixture": "todo-cli",
      "request": "In this project, add an exported function done(todos, id) and a command `node todo.js done <id>` that marks a task as done. format() must show done tasks with \"[x]\". Add tests.",
      "checks": [
        { "id": "own-tests-added", "kind": "test_cases_grow", "baseline": 3 },
        { "id": "existing-and-hidden-tests", "kind": "command", "command": "node --test", "hidden_files": ["hidden/todo-done.test.js"] }
      ]
    },
    {
      "id": "t3-invoice-bug",
      "persona": "freelance",
      "fixture": "invoice",
      "request": "My clients complain: the total including tax on my invoices is off by a few cents when there are several lines. Fix it.",
      "checks": [
        { "id": "hidden-rounding-tests", "kind": "command", "command": "node --test", "hidden_files": ["hidden/invoice-rounding.test.js"] }
      ]
    },
    {
      "id": "t4-vague-site",
      "persona": "beginner",
      "fixture": null,
      "request": "Make me a website for my bakery Au Bon Pain, in Lyon.",
      "checks": [
        { "id": "home", "kind": "html_exists" },
        { "id": "name", "kind": "html_contains", "pattern": "Au Bon Pain" },
        { "id": "city", "kind": "html_contains", "pattern": "Lyon" },
        { "id": "hours", "kind": "html_contains", "pattern": "(?i)hours|open" },
        { "id": "contact", "kind": "html_contains", "pattern": "(?i)<form|mailto:|tel:" },
        { "id": "mobile", "kind": "html_contains", "pattern": "(?i)name=[\"']viewport[\"']" },
        { "id": "english", "kind": "html_contains", "pattern": "(?i)<html[^>]*lang=[\"']en" },
        { "id": "links", "kind": "local_links_ok" }
      ]
    },
    {
      "id": "t5-csv-export",
      "persona": "developer",
      "fixture": "todo-cli",
      "request": "Add a command `node todo.js export <file.csv>` that exports the tasks as CSV (columns id,text,done) and an exported function toCsv(todos). Task text can contain commas, quotes and line breaks: the CSV must stay valid.",
      "checks": [
        { "id": "own-tests-added", "kind": "test_cases_grow", "baseline": 3 },
        { "id": "hidden-csv-tests", "kind": "command", "command": "node --test", "hidden_files": ["hidden/todo-csv.test.js"] }
      ]
    }
  ]
}
